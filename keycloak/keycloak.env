KC_FEATURES=preview
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true

KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_PORT=8442
KC_HTTPS_PORT=8443
KC_HTTPS_KEY_STORE_PASSWORD=STORE_PASSWORD
#KC_HTTPS_KEY_STORE_FILE=/etc/x509/https/truststore.jks
#KC_PROXY_HEADERS=xforwarded

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=qwerty

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=qwerty

KC_DB=postgres
#KC_DB_URL=jdbc:postgresql://host.docker.internal:5432/keycloak
#KC_DB_URL=jdbc:postgresql://project-postgres-db:5432/keycloak
KC_DB_URL=jdbc:postgresql://project-db:5432/keycloak
KC_DB_USERNAME=admin
KC_DB_PASSWORD=qwerty
KC_DB_SCHEMA=public